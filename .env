# JWT secret for admin auth tokens
JWT_SECRET="canteen_super_secret_jwt_key_2026"

# Razorpay Payment Gateway
# ------------------------------------------------------------------
# Leave these exactly as-is to run in the built-in TEST/SANDBOX mode:
# no real gateway calls are made, no real money moves, and checkout
# uses the app's own simulated payment modal.
#
# To go LIVE — i.e. actually accept real card/UPI payments (including
# UPI QR-code scanning, handled natively by Razorpay's own checkout) —
# replace these two values with real credentials from your Razorpay
# Dashboard (Settings > API Keys). The moment both values differ from
# the defaults below, the app automatically switches to live mode:
# no other code changes are needed.
RAZORPAY_KEY_ID="rzp_test_sampleKey123"
RAZORPAY_KEY_SECRET="sampleSecretKey123456"

