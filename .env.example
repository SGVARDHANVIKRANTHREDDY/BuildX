# JWT secret for admin auth tokens.
# ------------------------------------------------------------------
# Set this to a long random string in any real deployment. If you leave it
# unset, the server will auto-generate one on first run and persist it to
# server/data/.jwt_secret — fine for local/demo use, but every instance in a
# multi-instance deploy needs the SAME secret, so set this explicitly there.
JWT_SECRET=""

# Web Push (VAPID) keys — powers real push notifications: order-ready alerts
# to students and new-order alerts to admins, including on-phone vibration,
# even when the browser tab / app is closed.
# server/data/.vapid_keys.json — fine for local/demo use). For production,
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"

# Set to "true" only if this server sits behind a real reverse proxy
# (nginx, Render, Railway, etc.)leaving it
# unset on a direct/non-proxied deploy is the safer default.
TRUST_PROXY="false"

ALLOW_DEMO_CONCURRENCY="false"

ORDER_RETENTION_DAYS="90"


RAZORPAY_KEY_ID="rzp_test_sampleKey123"
RAZORPAY_KEY_SECRET="sampleSecretKey123456"

